# Dev image for libr3d: ROCm toolchain + a pinned out-of-tree install of radiance.
#
# Deliberately NOT radiance's shipping Dockerfile: that rebuilds ROCm's libLLVM for shipped-
# binary repeatability (VOPD pairing patch) and builds the RDNA4 image. For developing and
# kbench-checking an out-of-tree plugin we need the same ROCm (10.1.0-full, matching the
# shipping image's) with radiance installed so `find_package(radiance)` resolves.
#
#   docker build -t radiance-dev docker/
#   docker run --device /dev/kfd --device /dev/dri -v $PWD:/work radiance-dev <cmd>   # on a GPU host
#
# RAM note: a device-kernel TU takes 2-3 GB under hipcc (radiance's own Dockerfile says so).
# JOBS=2 fits a 7-8 GB VM; raise it on bigger hosts with --build-arg JOBS=N.

FROM rocm/dev-ubuntu-24.04:10.1.0-full

ARG RAD_REF=v1.11.0
ARG GPU_TARGETS=gfx1101;gfx11-generic
ARG JOBS=2

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      cmake ninja-build git ca-certificates gawk gcc-14 g++-14 \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --quiet https://codeberg.org/StillDeadcode/radiance.git /opt/radiance-src \
 && cd /opt/radiance-src && git checkout --detach "$RAD_REF"

# Prefix must be named at configure time (README: install-tree plugin discovery).
# Host C++ must be GCC (upstream Dockerfile pins CC=gcc-14 CXX=g++-14): abi/rad_runtime.h's
# RAD_OPD passes C compound literals, which ROCm's clang++ — first on the dev image's PATH —
# rejects in C++ mode ("taking address of temporary array"). GCC accepts it as an extension.
# Device code stays on ROCm's clang++ via CMAKE_HIP_COMPILER, as radiance's CMakeLists requires.
RUN cmake -S /opt/radiance-src -B /opt/radiance-build -G Ninja \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/opt/radiance \
      -DCMAKE_C_COMPILER=gcc-14 -DCMAKE_CXX_COMPILER=g++-14 \
      -DCMAKE_HIP_COMPILER=/opt/rocm/lib/llvm/bin/clang++ \
      -DRAD_GPU_TARGETS="${GPU_TARGETS}" \
 && cmake --build /opt/radiance-build -j"${JOBS}" \
 && cmake --install /opt/radiance-build \
 && rm -rf /opt/radiance-build

ENV CMAKE_PREFIX_PATH=/opt/radiance
ENV RADIANCE_HOME=/opt/radiance/share/radiance
ENV PATH=/opt/radiance/bin:$PATH
WORKDIR /work
